# Copy to .env (untracked) and set the password. Every line but the password
# is optional; the value shown is the default.
GRAFANA_ADMIN_PASSWORD=
# id -u and id -g of the user who ran tls.sh (the gateway must read the keys)
OBENHUB_UID=1000
OBENHUB_GID=1000
# service.namespace of the gateway's own telemetry; the host Collectors use the
# same value as OBENHUB_SERVICE_NAMESPACE, and inventory.yml names it
OBENHUB_NAMESPACE=obenhub
# address the Grafana, VictoriaMetrics, VictoriaLogs, vmalert and Alertmanager ports listen on
OBENHUB_BIND=127.0.0.1
# address and port of the OTLP/HTTP gateway
OBENHUB_GATEWAY_BIND=0.0.0.0
OBENHUB_GATEWAY_PORT=4318
OBENHUB_GRAFANA_PORT=3000
OBENHUB_VM_PORT=8428
OBENHUB_VL_PORT=9428
OBENHUB_VMALERT_PORT=8880
OBENHUB_ALERTMANAGER_PORT=9093
