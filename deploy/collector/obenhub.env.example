# Environment of a host Collector: base, tls overlay, collector, host and
# postgresql fragments, then the optional pgbouncer, patroni, etcd and
# pgbackrest ones. Reference: the "Collector fragment" table of each
# packs/<pack>/README.md. Keep the real file out of any repository (it holds
# passwords), mode 0600, and load it with systemd EnvironmentFile= or
# `set -a; . ./obenhub.env; set +a`. Values below are examples.

# base (packs/otelcol-base.yaml) and otelcol-tls.yaml
OBENHUB_GATEWAY_ENDPOINT=https://gateway.example.net:4318
OBENHUB_STORAGE_DIR=/var/lib/otelcol-contrib/obenhub
OBENHUB_TLS_DIR=/etc/otelcol-contrib/tls

# every fragment; must equal OBENHUB_NAMESPACE of deploy/compose and
# service.namespace in inventory.yml
OBENHUB_SERVICE_NAMESPACE=obenhub

# collector pack
OBENHUB_COLLECTOR_INSTANCE_ID=otelcol-host-1

# host pack
OBENHUB_HOST_INSTANCE_ID=host-1
OBENHUB_HOST_JOURNAL_UNITS='[postgresql, otelcol-contrib]'

# postgresql pack
OBENHUB_CLUSTER_NAME=main
OBENHUB_PG_HOST=127.0.0.1
OBENHUB_PG_PORT=5432
OBENHUB_PG_INSTANCE_ID=pg-1
OBENHUB_PG_USER=otel_monitor
OBENHUB_PG_PASSWORD=
OBENHUB_PG_DATABASES='[postgres]'
# the one database the slow tier (queries-slow.yaml, every 5 minutes) reads; one more instance per database (README)
OBENHUB_PG_SLOW_DATABASE=postgres
OBENHUB_PG_SSLMODE=disable
OBENHUB_PG_TLS_INSECURE=true
OBENHUB_PG_CA_FILE=/etc/otelcol-contrib/tls/pg-ca.crt
OBENHUB_PG_LOG_GLOB=/var/log/postgresql/postgresql-*.json

# pgbouncer pack (optional; uses OBENHUB_CLUSTER_NAME too)
OBENHUB_PGBOUNCER_HOST=127.0.0.1
OBENHUB_PGBOUNCER_PORT=6432
OBENHUB_PGBOUNCER_INSTANCE_ID=pgbouncer-1
OBENHUB_PGBOUNCER_USER=otel_monitor
OBENHUB_PGBOUNCER_PASSWORD=
OBENHUB_PGBOUNCER_SSLMODE=disable

# patroni pack (optional)
OBENHUB_PATRONI_HOST=127.0.0.1
OBENHUB_PATRONI_PORT=8008
OBENHUB_PATRONI_SCHEME=http
OBENHUB_PATRONI_INSTANCE_ID=pg-1
OBENHUB_PATRONI_CA_FILE=/etc/otelcol-contrib/tls/patroni-ca.crt

# etcd pack (optional)
OBENHUB_ETCD_CLUSTER_NAME=main-etcd
OBENHUB_ETCD_HOST=127.0.0.1
OBENHUB_ETCD_PORT=2379
OBENHUB_ETCD_INSTANCE_ID=pg-1
OBENHUB_ETCD_METRICS_ENDPOINT=127.0.0.1:2381

# pgbackrest pack (optional)
OBENHUB_PGBACKREST_HOST=127.0.0.1
OBENHUB_PGBACKREST_PORT=9854
OBENHUB_PGBACKREST_INSTANCE_ID=pgbackrest-1
