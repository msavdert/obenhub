# Environment of a Collector that monitors one Oracle CDB: base, tls overlay,
# collector, oracledb-dg and (optional) oracledb-backup fragments. Reference:
# the "Collector fragment" table of packs/oracledb-dg/README.md. Keep the real
# file out of any repository (it holds passwords), mode 0600. Values below are
# examples. Guide: docs/guides/monitor/oracle.md.

# base (packs/otelcol-base.yaml) and otelcol-tls.yaml
OBENHUB_GATEWAY_ENDPOINT=https://gateway.example.net:4318
OBENHUB_STORAGE_DIR=/var/lib/otelcol-contrib/obenhub
OBENHUB_TLS_DIR=/etc/otelcol-contrib/tls

# every fragment; must equal OBENHUB_NAMESPACE of deploy/compose and
# service.namespace in inventory.yml
OBENHUB_SERVICE_NAMESPACE=obenhub

# collector pack
OBENHUB_COLLECTOR_INSTANCE_ID=otelcol-host-1

# oracledb-dg and oracledb-backup packs
# obenhub.cluster.name; db_unique_name is service.instance.id
OBENHUB_CLUSTER_NAME=main
OBENHUB_ORACLE_DB_UNIQUE_NAME=ORCL
# listener host and port, and the service of the CDB root (not a PDB)
OBENHUB_ORACLE_HOST=db.example.net
OBENHUB_ORACLE_PORT=1521
OBENHUB_ORACLE_SERVICE=ORCL
# the two users of deploy/oracle/monitoring-user.sql; the DG user is
# percent-encoded for the URL (# is %23)
OBENHUB_ORACLE_MON_USER=C##OBENHUB_MON
OBENHUB_ORACLE_MON_PASSWORD=
OBENHUB_ORACLE_DG_USER=C%23%23OBENHUB_DG
OBENHUB_ORACLE_DG_PASSWORD=
# absolute path of the instance alert log, on the host the Collector runs on
OBENHUB_ORACLE_ALERT_LOG=/u01/app/oracle/diag/rdbms/orcl/ORCL/trace/alert_ORCL.log
