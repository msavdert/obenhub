{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Istanbul",
  "schedule": [
    "before 6am on monday"
  ],
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "ignoreDeps": [
    "obenhub-stage3-node"
  ],
  "mise": {
    "managerFilePatterns": [
      "/(^|/)mise\\.toml$/"
    ]
  },
  "packageRules": [
    {
      "description": "GitHub Actions, pinned by digest",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "ci"
    },
    {
      "description": "Tools pinned in mise.toml",
      "matchManagers": [
        "mise"
      ],
      "groupName": "dev tools"
    },
    {
      "description": "The runner image is pinned on purpose; move it deliberately.",
      "matchDatasources": [
        "github-runners"
      ],
      "enabled": false
    },
    {
      "description": "Python is fixed at 3.13; only patch releases arrive.",
      "matchDepNames": [
        "python"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "enabled": false
    },
    {
      "description": "VictoriaMetrics single-node, vmalert and vmalert-tool share one release train",
      "matchPackageNames": [
        "victoriametrics/victoria-metrics",
        "victoriametrics/vmalert",
        "victoriametrics/vmalert-tool"
      ],
      "groupName": "victoriametrics"
    },
    {
      "description": "The Collector image in the lab and the release tarball installed on pg-lab move together",
      "matchPackageNames": [
        "otel/opentelemetry-collector-contrib",
        "open-telemetry/opentelemetry-collector-releases"
      ],
      "groupName": "opentelemetry collector"
    },
    {
      "description": "A new PostgreSQL major is a stage decision (ADR 0001), not a dependency update",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "postgres",
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "The two VictoriaMetrics Grafana plugins share one compose line",
      "matchPackageNames": [
        "VictoriaMetrics/victoriametrics-datasource",
        "VictoriaMetrics/victorialogs-datasource"
      ],
      "groupName": "grafana plugins"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions annotated with a '# renovate:' comment on the line above a NAME=version assignment in lab shell scripts",
      "managerFilePatterns": [
        "/^lab/.+\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s+[A-Z_]+=(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Container images pinned as repository:tag@digest under a '# renovate: datasource=docker' comment in lab shell scripts",
      "managerFilePatterns": [
        "/^lab/.+\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=docker\\s+[A-Z_]+=(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Debian package pins in lab Dockerfiles: a '# renovate: datasource=deb depName=<package>' comment above an ARG NAME=version line. The repository (PGDG trixie) is set here for all of them. Unconfirmed: not yet seen to open a pull request.",
      "managerFilePatterns": [
        "/^lab/.+/Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARG [A-Z_]+=(?<currentValue>\\S+)"
      ],
      "registryUrlTemplate": "https://apt.postgresql.org/pub/repos/apt?suite=trixie-pgdg&components=main&binaryArch=amd64"
    },
    {
      "customType": "regex",
      "description": "vmalert-tool image in the lab:rules-test task; moves with vmalert",
      "managerFilePatterns": [
        "/(^|/)mise\\.toml$/"
      ],
      "matchStrings": [
        "(?<depName>victoriametrics/vmalert-tool):(?<currentValue>v[0-9.]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Grafana plugins preinstalled by the lab compose files",
      "managerFilePatterns": [
        "/^lab/.+/compose\\.ya?ml$/"
      ],
      "matchStrings": [
        "victoriametrics-metrics-datasource@(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "VictoriaMetrics/victoriametrics-datasource",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Grafana plugins preinstalled by the lab compose files",
      "managerFilePatterns": [
        "/^lab/.+/compose\\.ya?ml$/"
      ],
      "matchStrings": [
        "victoriametrics-logs-datasource@(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "VictoriaMetrics/victorialogs-datasource",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ]
}
