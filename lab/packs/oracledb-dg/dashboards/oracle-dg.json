      ],
      "description": "Protection level below the configured mode (degraded 1) and archive destinations leaving VALID (valid 0): the remote destination of the primary in the transport-cut scenario, the local destination 1 of the primary in the archiver-stuck scenario. One valid and one gap series per destination and per database (the primary lists its local and remote destinations, the standby its local one). The gap series stays 0 in both scenarios.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "lineInterpolation": "stepAfter"
