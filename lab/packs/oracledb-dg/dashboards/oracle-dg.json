{
  "uid": "obenhub-oracle-dg",
  "title": "Oracle Data Guard",
  "tags": [
    "obenhub",
    "oracle",
    "dataguard"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "utc",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Collector up",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "count(otelcol_process_uptime{service.instance.id=\"otelcol-ora-dg-obs\"}) or vector(0)",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "description": "The observer Collector on ora-dg-obs (otelcol_process_uptime with service.instance.id otelcol-ora-dg-obs): 1 while it reports, 0 when it stops. The gateway Collector is not counted.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Databases with heartbeat",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "count(oracledb.collection.heartbeat)",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "description": "Databases whose SELECT 1 through the SYSDG connection is present (2 for the pair).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Primaries",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "sum(oracledb.database.primary)",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "description": "Databases reporting the PRIMARY role. 1 at steady state. After a switchover or failover the old role-labelled series stay readable for up to about 5 minutes, so it can show 2 transiently; 0 is a role problem.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "title": "Redo apply running",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "min(oracledb.dataguard.apply.running)",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "description": "1 while the managed recovery process exists on the standby. Goes to 0 in the apply-stopped scenario.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "title": "FSFO observer present",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "min(oracledb.fast_start_failover.observer_present)",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "description": "1 while the databases see a fast-start failover observer. Goes to 0 in the observer-stopped scenario.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 6,
      "title": "Alerts firing",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "count(ALERTS{alertstate=\"firing\",alertname!=\"Watchdog\"}) or vector(0)",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "description": "Firing alerts other than the Watchdog.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 7,
      "title": "Standby lag",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "oracledb.dataguard.lag",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "{{oracledb.database.unique_name}} {{oracledb.dataguard.lag.type}}"
        }
      ],
      "description": "V$DATAGUARD_STATS lag on the standby (oracledb.dataguard.lag). Apply lag grows about one second per second in the apply-stopped scenario; in transport-cut it stays 0 because no redo arrives (see the data age panel).",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Lag data age",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "oracledb.dataguard.lag.data_age",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "{{oracledb.database.unique_name}} {{oracledb.dataguard.lag.type}}"
        }
      ],
      "description": "Time since the standby last received the data its lag is computed from (oracledb.dataguard.lag.data_age). Grows in the transport-cut scenario while the lag value stays 0.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "Redo apply and archive gap",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "oracledb.dataguard.apply.running",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "apply running {{oracledb.database.unique_name}}"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "oracledb.dataguard.missing_log.count",
          "refId": "B",
          "range": true,
          "instant": false,
          "legendFormat": "missing logs {{oracledb.database.unique_name}}"
        }
      ],
      "description": "oracledb.dataguard.apply.running (0 after the broker sets APPLY-OFF: apply-stopped) and the archive gap size (oracledb.dataguard.missing_log.count).",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Fast-start failover",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm"
      },
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "oracledb.fast_start_failover.observer_present",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "observer present {{oracledb.database.unique_name}}"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "oracledb.fast_start_failover.synchronized",
          "refId": "B",
          "range": true,
          "instant": false,
          "legendFormat": "synchronized {{oracledb.database.unique_name}}"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "oracledb.fast_start_failover.enabled",
          "refId": "C",
          "range": true,
          "instant": false,
          "legendFormat": "enabled {{oracledb.database.unique_name}}"
        }
      ],
      "description": "Observer presence drops to 0 in the observer-stopped scenario. Synchronized may drop to 0 (UNSYNCHRONIZED) for a few samples, seen live including the window after a transport-cut revert.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "lineInterpolation": "stepAfter"
          },
          "max": 1.2,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "title": "Database role and open state",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm"
      },
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "oracledb.database.primary",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "primary {{oracledb.database.unique_name}} ({{oracledb.database.role}})"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "oracledb.database.open",
          "refId": "B",
          "range": true,
          "instant": false,
          "legendFormat": "open {{oracledb.database.unique_name}} ({{oracledb.database.open_mode}})"
        }
      ],
      "description": "1 for the PRIMARY role and for an open database. No scenario changes them; a switchover or failover would show here. Series carry the role and open mode as labels, so after a role change the old series stay readable for up to about 5 minutes.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "lineInterpolation": "stepAfter"
          },
          "max": 1.2,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "title": "Protection level and redo destination",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "oracledb.dataguard.protection.degraded",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "degraded {{oracledb.database.unique_name}} ({{oracledb.dataguard.protection_level}})"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "oracledb.archive_dest.valid",
          "refId": "B",
          "range": true,
          "instant": false,
          "legendFormat": "dest valid {{oracledb.archive_dest.destination}} ({{oracledb.archive_dest.status}})"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "oracledb.archive_dest.gapped",
          "refId": "C",
          "range": true,
          "instant": false,
          "legendFormat": "dest gap {{oracledb.archive_dest.destination}} ({{oracledb.archive_dest.gap_status}})"
        }
      ],
      "description": "Protection level below the configured mode (degraded 1) and a remote destination leaving VALID (valid 0) in the transport-cut scenario. The gap series stays 0 there.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "lineInterpolation": "stepAfter"
          },
          "max": 1.2,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "title": "Heartbeat per database",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "oracledb.collection.heartbeat",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "heartbeat {{service.instance.id}}"
        }
      ],
      "description": "1 when the SELECT 1 through the SYSDG connection succeeds. Stays at 1 in the control scenario.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "lineInterpolation": "stepAfter"
          },
          "max": 1.2,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "title": "Firing and pending alerts",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "sum by (alertname, alertstate, oracledb.database.unique_name) (ALERTS{alertname!=\"Watchdog\"})",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "{{alertname}} {{alertstate}} {{oracledb.database.unique_name}}"
        }
      ],
      "description": "Data only during a scenario: ALERTS series from vmalert (Oracle pack and collector pack), without the Watchdog. Empty at steady state; the control scenario expects it to stay empty.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
