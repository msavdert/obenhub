    {
      "id": 7,
      "title": "Standby lag",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "oracledb.dataguard.lag",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "{{oracledb.database.unique_name}} {{oracledb.dataguard.lag.type}}"
        }
      ],
      "description": "V$DATAGUARD_STATS lag on the standby (oracledb.dataguard.lag). Apply lag grows about one second per second in the apply-stopped scenario; in transport-cut it stays 0 because no redo arrives (see the data age panel).",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Lag data age",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
