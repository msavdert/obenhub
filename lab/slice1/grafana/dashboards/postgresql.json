    },
    {
      "id": 20,
      "title": "PgBouncer: average wait and query time",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm"
      },
      "gridPos": {
        "x": 12,
        "y": 52,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "rate(pgbouncer.stats.wait_time{database!=\"pgbouncer\"}[$__rate_interval]) / rate(pgbouncer.stats.server_assignments{database!=\"pgbouncer\"}[$__rate_interval]) / 1e6",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "{{database}} wait per server assignment"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "rate(pgbouncer.stats.query_time{database!=\"pgbouncer\"}[$__rate_interval]) / rate(pgbouncer.stats.queries{database!=\"pgbouncer\"}[$__rate_interval]) / 1e6",
          "refId": "B",
          "range": true,
          "instant": false,
          "legendFormat": "{{database}} query time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "SHOW STATS totals as rate ratios, in seconds: wait per server assignment and server time per query. Wait time is counted only when a wait ends in an assignment. Query time includes the wait (PgBouncer starts timing when the query arrives, not when a server is assigned). A database with no traffic in the window has no point. Not filtered by the instance variable: PgBouncer is its own target."
    },
