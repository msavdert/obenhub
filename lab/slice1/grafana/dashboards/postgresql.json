    },
    {
      "id": 14,
      "title": "Subscription: age of last message",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "postgresql.subscription.last_msg_age",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "{{subscription_name}} seconds since last message"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "60",
          "refId": "B",
          "range": true,
          "instant": false,
          "legendFormat": "LogicalSubscriptionNotStreaming threshold (s)"
