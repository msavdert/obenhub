{
  "uid": "obenhub-postgresql",
  "title": "PostgreSQL slice 1",
  "tags": [
    "obenhub"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "vm"
        },
        "query": "label_values(postgresql.collection.heartbeat, service.instance.id)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "current": {
          "text": "pg-standby",
          "value": "pg-standby"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Role",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "postgresql.recovery.active{service.instance.id=\"$instance\"}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "primary",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "standby (recovery)",
                  "color": "blue",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "description": "postgresql.recovery.active from the pack. Not a configured label: a promoted standby changes this value."
    },
    {
      "id": 2,
      "title": "Streaming",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "postgresql.wal_receiver.streaming{service.instance.id=\"$instance\"}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "no WAL receiver streaming",
                  "color": "orange",
                  "index": 0
                },
                "1": {
                  "text": "streaming",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "description": "1 when pg_stat_wal_receiver reports streaming. Always 0 on a primary; the alert only applies to a standby."
    },
    {
      "id": 3,
      "title": "Heartbeat",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "postgresql.collection.heartbeat{service.instance.id=\"$instance\"}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "collecting",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "description": "1 whenever the pack heartbeat query succeeded. No data means the target is silent (PostgresTargetAbsent)."
    },
    {
      "id": 4,
      "title": "Collector self-metric",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "otelcol_process_uptime",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {}
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "description": "otelcol_process_uptime; no data means the Collector is gone (CollectorAbsent)."
    },
    {
      "id": 5,
      "title": "Replay backlog",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "postgresql.replay.backlog{service.instance.id=\"$instance\"}",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "backlog"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 16777216
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Received minus replayed WAL on a standby. Alert threshold 16 MiB."
    },
    {
      "id": 6,
      "title": "Oldest snapshot age",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "postgresql.snapshot.oldest_age{service.instance.id=\"$instance\"}",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "oldest age"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Age of the oldest client transaction holding a snapshot or xid. Lab alert threshold 120 s."
    },
    {
      "id": 7,
      "title": "Client connections vs capacity",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "postgresql.connection.client{service.instance.id=\"$instance\"}",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "client connections"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "postgresql.connection.client_capacity{service.instance.id=\"$instance\"}",
          "refId": "B",
          "range": true,
          "instant": false,
          "legendFormat": "capacity"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "0.85 * postgresql.connection.client_capacity{service.instance.id=\"$instance\"}",
          "refId": "C",
          "range": true,
          "instant": false,
          "legendFormat": "alert threshold (85%)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Client backends against max_connections minus superuser and reserved slots."
    },
    {
      "id": 8,
      "title": "Commits and rollbacks per second",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "sum(rate(postgresql.commits{service.instance.id=\"$instance\"}[$__rate_interval]))",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "commits"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "sum(rate(postgresql.rollbacks{service.instance.id=\"$instance\"}[$__rate_interval]))",
          "refId": "B",
          "range": true,
          "instant": false,
          "legendFormat": "rollbacks"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "postgresqlreceiver sums are cumulative counters, so these are rate() over them, summed over databases."
    },
    {
      "id": 9,
      "title": "PostgreSQL ERROR and FATAL (server log)",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "vl"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "vl"
          },
          "expr": "service.name:=postgresql service.instance.id:=\"$instance\" severity_text:in(ERROR,FATAL,PANIC)",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "description": "jsonlog records read by filelog, for the selected instance."
    },
    {
      "id": 10,
      "title": "Delivered alert notifications",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "vl"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "vl"
          },
          "expr": "status:in(firing,resolved) | fields _time, status, commonLabels.alertname, commonLabels.service_instance_id, commonAnnotations.summary",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "description": "Everything Alertmanager delivered to the sink (all instances), including the Watchdog."
    }
  ]
}
