      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "postgresql.subscription.apply_errors",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "{{subscription_name}} apply errors"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "postgresql.subscription.sync_errors",
          "refId": "B",
          "range": true,
          "instant": false,
          "legendFormat": "{{subscription_name}} sync errors"
