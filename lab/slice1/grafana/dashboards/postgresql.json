          },
          "expr": "postgresql.subscription.enabled",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "{{subscription_name}} enabled"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "postgresql.subscription.apply_worker_running",
          "refId": "B",
          "range": true,
          "instant": false,
          "legendFormat": "{{subscription_name}} apply worker running"
