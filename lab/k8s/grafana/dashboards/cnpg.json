    {
      "id": 8,
      "title": "Replication slots: WAL retained",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "postgresql.replication_slot.retained_wal",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "{{service.instance.id}} {{postgresql.replication_slot.name}}"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "vm"
          },
          "expr": "512 * 1024 * 1024",
          "refId": "B",
          "range": true,
          "instant": false,
          "legendFormat": "PostgresReplicationSlotRetainingWAL threshold"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Data only during a scenario. retained_wal is current LSN minus restart_lsn. The pack returns no slot row while the cluster has no slot; the slot-retaining-wal scenario creates one. The threshold line is always drawn."
    },
